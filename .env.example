# Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Evolution API (WhatsApp real) — Fase 11 / Onda 1
EVOLUTION_ENABLED="false"                          # feature flag mestre: sem ela o CRM segue em modo demo
EVOLUTION_API_URL="https://crm-evo-malas.duckdns.org"
EVOLUTION_API_KEY="chave-global-da-evolution"      # NUNCA exposta ao frontend
EVOLUTION_WEBHOOK_SECRET="segredo-do-webhook"      # header x-evolution-webhook-secret
EVOLUTION_INSTANCE_PREFIX="crm"                    # nomes de instância: crm-<slug-da-loja>
EVOLUTION_TIMEOUT_MS="15000"                       # timeout das chamadas HTTP (1000–60000)

# URL pública do CRM (destino do webhook da Evolution). Na Vercel: a URL do projeto; local: túnel.
APP_PUBLIC_URL="http://localhost:3001"
