# .env.example — modelo do .env da Evolution API (o bootstrap gera o real)
# NUNCA versione o .env real. Os placeholders são trocados na criação.

# Usada pelo docker-compose (serviço postgres) e pela URI de conexão abaixo.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://__DOMAIN__
# Limita o heap do Node para caber no mem_limit de 560 MB da VM de 1 GB.
NODE_OPTIONS=--max-old-space-size=384

LANGUAGE=pt-BR
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
DEL_INSTANCE=false
TELEMETRY=false

# ---------------------------------------------------------------- Banco
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:__POSTGRES_PASSWORD__@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
# Só os dados da instância importam para o CRM: as mensagens são gravadas no nosso banco.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# ---------------------------------------------------------------- Cache
# Sem Redis: cache em memória. Economiza ~80 MB de RAM na VM gratuita.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# ---------------------------------------------------------------- Auth
AUTHENTICATION_API_KEY=__API_KEY__
# Permite ao backend listar instâncias com a chave global (só o servidor usa).
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ---------------------------------------------------------------- Sessão / QR
CONFIG_SESSION_PHONE_CLIENT=CRM Facil IA
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=45

# ---------------------------------------------------------------- Webhook
# O webhook é configurado por instância via API (com header secreto), não global.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_EVENTS_ERRORS=false

# ---------------------------------------------------------------- Integrações (desligadas)
S3_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
